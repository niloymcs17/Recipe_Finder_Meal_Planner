{
  "name": "recipe-finder-meal-planner",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:ui": "pnpm --filter @recipe-finder/ui start",
    "dev:web": "pnpm --filter @recipe-finder/web dev",
    "build": "pnpm --filter @recipe-finder/ui build && pnpm --filter @recipe-finder/web build",
    "build:ui": "pnpm --filter @recipe-finder/ui build",
    "build:web": "pnpm --filter @recipe-finder/web build",
    "check": "pnpm --filter @recipe-finder/web check",
    "test": "pnpm --filter @recipe-finder/ui test"
  },
  "engines": {
    "node": ">=20"
  }
}
